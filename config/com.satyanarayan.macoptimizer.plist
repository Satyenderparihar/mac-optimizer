<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.satyanarayan.macoptimizer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/geniustradingwallah/.mac_optimizer/mac_cleaner.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <array>
        <!-- Daily at 8:00 AM (Morning Clean) -->
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- Daily at 2:00 PM (Afternoon Refresh) -->
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/geniustradingwallah/.mac_optimizer/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/geniustradingwallah/.mac_optimizer/launchd_err.log</string>
</dict>
</plist>
